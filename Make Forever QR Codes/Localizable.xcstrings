          }
        }
      }
    },
    "The information is saved on your device. No server sits in between, so nobody can switch your code off." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La información se guarda en tu dispositivo. No hay ningún servidor en medio, así que nadie puede desactivar tu código."
          }
        }
      }
    },
